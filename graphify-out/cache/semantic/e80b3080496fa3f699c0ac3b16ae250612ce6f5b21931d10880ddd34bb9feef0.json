{"nodes": [{"id": "table_definetion_tasks", "label": "tasks table (Task core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task rows hold only intrinsic data (title, target_description, exit_criteria); state, labels, project/goal membership, deadlines, budgets, and dependencies are deliberately externalized to relations and supporting tables."}, {"id": "table_definetion_goals", "label": "goals table (Goal core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_projects", "label": "projects table (Project core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_ideas", "label": "ideas table (Idea core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_philosophies", "label": "philosophies table (Philosophy core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_workflows", "label": "workflows table (Workflow core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each row is one version of a definition; publishing freezes the row and successors form an explicit lineage chain through supersedes_id so historical execution is never rewritten."}, {"id": "table_definetion_resources", "label": "resources table (Resource core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraints (deadlines, allocations) are not intrinsic Resource fields; they are represented through core relations with metadata so any entity can be constrained by any Resource."}, {"id": "table_definetion_records", "label": "records table (Record core concept)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records capture what actually happened (occurred_at distinct from recorded_at) with typed payloads; relationships to other core concepts live in relations, keeping the Record itself a pure occurrence fact."}, {"id": "table_definetion_relations", "label": "relations table (semantic core graph)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relations are temporal (ended_at) and carry metadata, so ending a relation preserves history and resource constraints/allocations/consumption can all be expressed as typed edges without schema changes."}, {"id": "table_definetion_labels", "label": "labels table (Label classification)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_entity_labels", "label": "entity_labels table (generic label assignment)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One generic temporal assignment table replaces per-entity join tables such as task_labels, so any core concept can receive any Label without new schema."}, {"id": "table_definetion_workflow_states", "label": "workflow_states table (reusable state templates)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_workflow_state_transitions", "label": "workflow_state_transitions table", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_project_states", "label": "project_states table (Project-owned states)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "source_workflow_state_id is provenance only: after initialization the Project State becomes independent, so later Workflow template edits never silently mutate an existing Project machine."}, {"id": "table_definetion_project_state_transitions", "label": "project_state_transitions table", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_definetion_project_entity_states", "label": "project_entity_states table (runtime state history)", "file_type": "concept", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-oriented state periods (entered_at/ended_at) replace in-place status columns, so current state is simply the row with ended_at IS NULL and full lifecycle history is preserved."}, {"id": "table_definetion_state_machine_identity", "label": "State machine identity (workflow/project + entity_type + label)", "file_type": "rationale", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoping machines by workflow_id/project_id + entity_type + label_id lets different entity kinds share a Label yet follow different lifecycles, and lets Labels be pure classification when no machine is defined."}, {"id": "table_definetion_no_foreign_keys", "label": "No foreign keys / no entities table rule", "file_type": "rationale", "source_file": "Table-definetion.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All cross-table references (workflow_id, label_id, entity_id, from/to_state_id, ...) are logical only; the application/domain layer validates them, keeping integrity rules explicit and testable in domain code rather than hidden in the database."}], "edges": [{"source": "table_definetion_entity_labels", "target": "table_definetion_labels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Table-definetion.txt", "source_location": null, "weight": 1.0}, {"source": "table_definetion_workflow_states", "target": "table_definetion_workflows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Table-definetion.txt", "source_location": null, "weight": 1.0}, {"source": "table_definetion_workflow_state_transitions", "target": "table_definetion_workflow_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Table-definetion.txt", "source_location": null, "weight": 1.0}, {"source": "table_definetion_project_states", "target": "table_definetion_workflow_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Table-definetion.txt", "source_location": null, "weight": 1.0}, {"source": "table_definetion_project_state_transitions", "target": "table_definetion_workflow_state_transitions", "relation": "references", "confidence": "EXTRACTED